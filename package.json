{
  "name": "meeting-notes",
  "version": "1.2.5",
  "description": "Local meeting notes tracker",
  "main": "main.js",
  "author": "Dean Hume",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "web": "node server.js",
    "fetch-model": "node scripts/fetch-model.js",
    "test": "jest",
    "benchmark:summary": "node scripts/benchmark-summary.js",
    "benchmark:brief": "node scripts/benchmark-brief.js",
    "bump": "npm version patch --no-git-tag-version",
    "build": "electron-builder --win --x64  ",
    "buildnobump": "electron-builder --win --x64  ",
    "build:dir": "npm version patch --no-git-tag-version && electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.deanhume.meetingnotes",
    "productName": "Meeting Notes",
    "artifactName": "Meeting-Notes-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "deanhume",
        "repo": "meeting-notes"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/images/logo-app-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "transcription.js",
      "transcript-file.js",
      "server.js",
      "shared.js",
      "public/**/*",
      "!public/models/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/models",
        "to": "models"
      }
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "node-wav": "^0.0.2"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
